NODE_ENV=production
DEEMIX_DATA_DIR=/var/lib/deemix/config
DEEMIX_MUSIC_DIR=/srv/deemix/downloads
DEEMIX_SERVER_PORT=6595
DEEMIX_HOST=127.0.0.1
DEEMIX_SINGLE_USER=true

# These values are inherited by deemix-to-drive.
DTD_REMOTE=gdrive:Music
DTD_CONFIG=/var/lib/deemix/.config/rclone/rclone.conf
DTD_RCLONE=/usr/bin/rclone
DTD_SOURCE_ROOT=/srv/deemix/downloads
DTD_LOG=/var/log/deemix-to-drive.log
DTD_LOCK=/var/lib/deemix/deemix-to-drive.lock
DTD_MODE=move
